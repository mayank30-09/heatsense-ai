APP_NAME=heatsense-api
APP_ENV=development
API_V1_PREFIX=/api/v1
POSTGRES_DB=heatsense
POSTGRES_USER=heatsense
# choose your own POSTGRES_PASSWORD; DEV_USER_PASSWORD is the password for the seeded dev logins and must be set when starting the backend
POSTGRES_PASSWORD=change_me
DEV_USER_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://heatsense:change_me@localhost:5433/heatsense
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
