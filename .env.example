APP_NAME=heatsense-api
APP_ENV=development
API_V1_PREFIX=/api/v1
POSTGRES_DB=heatsense
POSTGRES_USER=heatsense
# set your own value; compose and the dev logins will not start with an empty value
POSTGRES_PASSWORD=
DEV_USER_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# replace PASSWORD with the value of POSTGRES_PASSWORD set above
DATABASE_URL=postgresql+psycopg://heatsense:PASSWORD@localhost:5433/heatsense
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
